# Copie para .env e preencha. NUNCA versionar o .env.
# Todos os valores abaixo são PLACEHOLDERS — não são credenciais reais.

# --- Banco de dados ---
# Dev local (docker-compose.yml sobe o Postgres na 55433):
DATABASE_URL=postgres://guia:guia@localhost:55433/guia_hospede
# Produção (Neon): cole a connection string do painel, com ?sslmode=require

# --- LLM (servidor apenas — nunca prefixar com NEXT_PUBLIC_) ---
# Chave da API do DeepSeek: https://platform.deepseek.com
DEEPSEEK_API_KEY=coloque-sua-chave-aqui
# Modelo usado para gerar o guia e responder no chat.
DEEPSEEK_MODEL=deepseek-v4-flash
